+/* ---------- Relatório do mês ---------- */
+
+select {
+  width: 100%;
+  font: inherit;
+  font-size: 16px;
+  min-height: 48px;
+  padding: 10px 14px;
+  border: 1px solid var(--borda);
+  border-radius: 12px;
+  background: #fff;
+  color: var(--texto);
+}
+select:focus { outline: 3px solid var(--berinjela-media); outline-offset: 2px; }
+
+.rel-topo {
+  margin-top: 14px;
+  padding: 14px;
+  border-radius: 14px;
+  background: var(--berinjela-clara);
+}
+.rel-total { margin: 0; font-size: 2rem; font-weight: 700; color: var(--berinjela); }
+.rel-comparacao { margin: 4px 0 0; font-weight: 600; color: var(--texto-suave); }
+.rel-comparacao.bom { color: #2F7A3E; }
+.rel-comparacao.atencao { color: var(--coral-escuro); }
+.rel-qtd { margin: 2px 0 0; color: var(--texto-suave); font-size: 0.92rem; }
+
+.rel-titulo { font-size: 1rem; color: var(--berinjela); margin: 18px 0 8px; }
+.rel-cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.rel-linha { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 4px; font-size: 0.95rem; }
+.rel-valor { font-weight: 600; white-space: nowrap; }
+.rel-maiores { counter-reset: none; }
+.rel-economias { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
+.rel-economias li::marker { color: #2F7A3E; }
+.rel-cofrinho { margin: 0; }
+.rel-vazio { margin-top: 14px; }
+
+/* Aviso de relatório pronto */
+.aviso-relatorio {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 16px;
+  padding: 4px 4px 4px 14px;
+  border-radius: 14px;
+  background: var(--ambar-clara);
+  border: 1px solid var(--ambar);
+  color: var(--berinjela);
+  font-weight: 600;
+}
+.aviso-relatorio span { flex: 1; }
+.aviso-relatorio .btn-texto { color: var(--berinjela); }
+
 /* ---------- Janela de alerta de limite ---------- */
 
 .janela {
