+/* ---------- Ícones e ilustrações ---------- */
+
+.sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
+
+.ic {
+  width: 20px;
+  height: 20px;
+  flex: none;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 2;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.com-icone { display: flex; align-items: center; gap: 8px; }
+.btn.com-icone { justify-content: center; }
+h2.com-icone .ic { width: 22px; height: 22px; color: var(--coral-escuro); }
+
+.ilustracao { display: block; width: 200px; height: auto; margin: 0 auto; }
+.ilustracao.pequena { width: 140px; margin-bottom: 8px; }
+.marca .ilustracao { width: 220px; margin-bottom: 4px; }
+
+/* Topo com saudação */
+.saudacao { margin: 0; color: var(--texto-suave); font-size: 0.95rem; }
+.topo h1 { font-size: 1.6rem; }
+
+/* Cabeçalho do cartão do total */
+.total-topo { display: flex; align-items: center; gap: 10px; }
+.selo {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 36px;
+  height: 36px;
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.16);
+  color: #FFD36B;
+}
+.valor-total { font-size: 2.6rem; }
+
+/* Círculo colorido da categoria */
+.selo-cat {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 40px;
+  height: 40px;
+  border-radius: 50%;
+  background: var(--fundo);
+  color: var(--cor);
+  flex: none;
+}
+.selo-cat .ic { width: 20px; height: 20px; }
+.selo-cat.mini { width: 24px; height: 24px; }
+.selo-cat.mini .ic { width: 14px; height: 14px; }
+
+.barra-nome { display: inline-flex; align-items: center; gap: 8px; }
+
+/* Botões de categoria com ícone na cor da categoria */
+.chip { display: inline-flex; align-items: center; gap: 6px; }
+.chip .ic { width: 18px; height: 18px; color: var(--cor); }
+.chip[aria-checked="true"] .ic { color: #fff; }
+
+/* Editar e Apagar com ícone */
+.btn-editar, .btn-apagar { display: inline-flex; align-items: center; gap: 6px; }
+.btn-editar .ic, .btn-apagar .ic { width: 16px; height: 16px; }
+.btn-texto.com-icone .ic { width: 18px; height: 18px; }
+
 /* ---------- Computador ---------- */
 
